{
  "name": "dental-manager",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:worker": "npm --prefix backend-worker run dev",
    "worker:typecheck": "npm --prefix backend-worker run typecheck",
    "worker:test": "npm --prefix backend-worker run test",
    "worker:deploy": "npm --prefix backend-worker run deploy",
    "worker:deploy:dry-run": "npm --prefix backend-worker run deploy:dry-run",
    "worker:d1:create": "npm --prefix backend-worker run d1:create",
    "worker:r2:create:reports": "npm --prefix backend-worker run r2:create:reports",
    "worker:r2:create:uploads": "npm --prefix backend-worker run r2:create:uploads",
    "d1:export-sqlite": "python scripts/export-sqlite-to-d1.py",
    "d1:migrate:local": "npm --prefix backend-worker run d1:migrate:local",
    "d1:migrate:remote": "npm --prefix backend-worker run d1:migrate:remote",
    "d1:import:remote": "npm --prefix backend-worker run d1:import:remote"
  }
}
