{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dental-manager-api",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_NAME": "Dental Manager",
    "APP_ENV": "production",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "720",
    "ADMIN_USERNAME": "admin",
    "ADMIN_PASSWORD": "admin12345",
    "CORS_ORIGINS": "https://spv.devemaclinic.com,http://localhost:5173,http://localhost:8080",
  },
  "routes": [
    {
      "pattern": "spv.devemaclinic.com/api/*",
      "zone_name": "devemaclinic.com",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dental-manager",
      "database_id": "6a5d3234-d2d0-47a5-ae31-a170b4f7f89d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "dental-manager-reports",
    },
    {
      "binding": "UPLOADS",
      "bucket_name": "dental-manager-uploads",
    },
  ],
  "triggers": {
    "crons": ["17 18 * * *"],
  },
}
